# Lumen — exemplo de configuração.
# Copie este arquivo para ".env" e ajuste os valores.
# NUNCA coloque chaves reais em arquivos versionados.

# Provedor de IA: "mock" (offline, sem API), "ollama" (local), "openai" (API real),
# "gemini" (API real do Google Gemini), "groq" (GroqCloud) ou
# "together" (Together AI — modelos Llama 4)
LUMEN_PROVIDER=mock

# Modelo a utilizar. Obrigatório para openai (ex.: gpt-4o-mini).
# Vazio usa o padrão do provedor: ollama → qwen2.5-coder:7b-instruct-q8_0 ·
# gemini → gemini-2.5-flash · groq → openai/gpt-oss-120b ·
# together → meta-llama/Llama-4-Scout-17B-16E-Instruct
LUMEN_MODEL=

# Chave de API do provedor (obrigatória quando LUMEN_PROVIDER=openai)
LUMEN_API_KEY=

# Ollama local (sem API key)
LUMEN_OLLAMA_BASE_URL=http://127.0.0.1:11434
LUMEN_OLLAMA_KEEP_ALIVE=5m

# Diretório de dados (memória, tarefas e logs); relativo à raiz do projeto
LUMEN_DATA_DIR=data

# Nível de logging: DEBUG | INFO | WARNING | ERROR | CRITICAL
LUMEN_LOG_LEVEL=INFO

# Máximo de mensagens de histórico enviadas ao provedor em cada conversa
LUMEN_MAX_CONTEXT_MESSAGES=50

# Timeout (segundos) para chamadas ao provedor de IA
LUMEN_REQUEST_TIMEOUT=60

# Retries adicionais para erros temporários (rate limit, rede, timeout, 5xx)
LUMEN_MAX_RETRIES=2

# Máximo de registros da memória estruturada selecionados como contexto
# para um pedido (fundação da memória inteligente — Lumen 0.3)
LUMEN_MAX_MEMORY_RECORDS=12

# ── Pesquisa web (Fase 1) ────────────────────────────────────────────
# Provedor usado pela tool "web_search". Ela só entra no planner quando
# habilitada explicitamente pela UI (Ferramentas) ou pelo opt-in MCP.
# Deixe vazio para desabilitar a criação automática do provedor.
#   tavily (recomendado — devolve trechos já extraídos)
#   brave  (alternativa)
LUMEN_SEARCH_PROVIDER=

# Chave Tavily (https://app.tavily.com) — necessária para LUMEN_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=

# Chave Brave Search (https://brave.com/search/api/) — para LUMEN_SEARCH_PROVIDER=brave
BRAVE_API_KEY=

# ── Ponte Unreal (Fase 4) ────────────────────────────────────────────
# A ponte é DESLIGADA por padrão: nada acontece até habilitá-la
# explicitamente na UI (somente leitura) ou no servidor MCP. Ver TESTE_LOCAL.md.
#
# Porta HTTP da Remote Control API do Unreal Editor (default 30010).
# A RC API NÃO tem autenticação — mantenha em 127.0.0.1.
LUMEN_UNREAL_RC_HOST=127.0.0.1
LUMEN_UNREAL_RC_PORT=30010
# Transporte da ponte:
#   rc     -> só as rotas HTTP da Remote Control API (sem criar assets)
#   python -> exige o Python Editor Script Plugin habilitado
#   auto   -> RC API sempre; Python para o que só ele faz (default)
LUMEN_UNREAL_TRANSPORT=auto
# Timeout por chamada ao editor (segundos; 0 < t <= 300)
LUMEN_UNREAL_TIMEOUT=30

# ── Servidor MCP (Fase 3) ────────────────────────────────────────────
# Nível de log do servidor MCP (os logs vão para o stderr; a saída do
# protocolo é o stdout). WARNING | INFO | DEBUG.
LUMEN_MCP_LOG_LEVEL=WARNING
