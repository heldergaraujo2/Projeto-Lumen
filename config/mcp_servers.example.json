{
  "schema_version": 1,
  "note": "Template only. Install and verify the selected MCP first. Copy to the runtime data directory, then set enabled=true and review each tool before allowing it. Never allow-list every tool by default.",
  "servers": [
    {
      "name": "desktop-ui",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "desk-mcp"],
      "cwd": null,
      "env": {},
      "enabled": false,
      "allowed_tools": [
        "computer_windows",
        "computer_screeninfo",
        "computer_screenshot",
        "computer_read_screen",
        "computer_find",
        "computer_verify_state",
        "computer_permissions",
        "computer_selftest"
      ],
      "request_timeout_seconds": 30,
      "startup_timeout_seconds": 30,
      "requires_human_approval_for": [
        "delete",
        "overwrite",
        "install",
        "uninstall",
        "shutdown",
        "restart",
        "credential",
        "security",
        "registry",
        "process-kill"
      ]
    }
  ]
}
