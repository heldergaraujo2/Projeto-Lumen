{
  "schema_version": 1,
  "note": "Copy to a local, untracked config only after reviewing each upstream server's official install instructions. Never let the model supply command/args.",
  "servers": [
    {
      "name": "desktop-ui",
      "transport": "stdio",
      "command": "npx.cmd",
      "args": ["--yes", "desk-mcp"],
      "cwd": null,
      "env": {},
      "enabled": false,
      "allowed_tools": [],
      "request_timeout_seconds": 30,
      "startup_timeout_seconds": 20,
      "requires_human_approval_for": ["delete", "overwrite", "install", "uninstall", "shutdown", "restart", "credential", "security", "registry", "process-kill"]
    }
  ]
}
